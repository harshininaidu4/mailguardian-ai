# Public origin of the deployed site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where "Sign In" sends people (your real product app)
NEXT_PUBLIC_APP_URL=https://app.mailguardian.ai

# Optional: every lead captured by /api/lead is POSTed here as JSON
# (Slack incoming webhook, Zapier/Make catch hook, HubSpot/Salesforce proxy, etc.)
LEAD_WEBHOOK_URL=

# IPinfo Core token. Keep this server-only: do not prefix it with NEXT_PUBLIC_.
# Used by POST /api/geolocate to enrich a public sender IP with approximate location data.
IPINFO_TOKEN=
